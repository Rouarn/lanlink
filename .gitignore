# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
packages/desktop/dist/
packages/desktop/src-tauri/target/
target/
*.app
*.app.zip
*.dmg
*.msi

# Tauri 生成物
packages/desktop/src-tauri/gen/

# Android 插件本地构建产物与 Tauri 复制进来的 api 源码
packages/desktop/src-tauri/plugins/*/android/build/
packages/desktop/src-tauri/plugins/*/android/.tauri/

# Python 缓存（图标处理等一次性脚本）
__pycache__/

# 临时分享包与本地预览
.trae-html-share-packages/
.screenshots/

# 会话/规格草稿
.trae/

# 内置 easytier 二进制：约 29MB/平台，本地构建与打包要用，但不进版本库。
# CI 会按目标平台从 EasyTier 官方 release 下载到同名目录（见 .github/workflows/build.yml）。
packages/core/**/easytier-core
packages/core/**/easytier-core.exe
packages/core/**/easytier-cli
packages/core/**/easytier-cli.exe

# EasyTier 源码与它引用的 GitHub 依赖（由 scripts/fetch-easytier.sh 拉取，约 60MB）
.easytier/
.easytier-deps/

# Go 查码服务产物
packages/server/dist/

# 运行期数据与日志
data/
packages/server/data/
*.log

# 本地环境变量
.env
.env.*

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
